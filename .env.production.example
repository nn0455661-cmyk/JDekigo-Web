# MẪU BIẾN MÔI TRƯỜNG DÀNH CHO VERCEL
# Điền từng biến trong Vercel > Project > Settings > Environment Variables.
# Không đổi tên file này thành `.env.production` rồi đưa secret lên Git.

# Bắt buộc
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Nên khai báo để cấu hình production rõ ràng
R2_UPLOAD_PREFIX=web-learn-japan/uploads
R2_TEMP_PREFIX=web-learn-japan/temp
R2_TEMP_MAX_AGE_HOURS=24
R2_MAX_UPLOAD_BYTES=15728640
R2_MAX_AUDIO_UPLOAD_BYTES=52428800
R2_IMAGE_MAX_DIMENSION=1920
R2_IMAGE_WEBP_QUALITY=82

# Không cần khai báo NEXT_PUBLIC_API_URL khi giao diện và API cùng chạy trên Vercel.
# Vercel tự đặt NODE_ENV=production, không cần thêm thủ công.
