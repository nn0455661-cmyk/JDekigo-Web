# Sao chép file này thành `.env.local`, sau đó điền các giá trị bắt buộc.
# Không đưa `.env` hoặc `.env.local` lên Git.

# ================================================================
# 1. BẮT BUỘC ĐỂ CHẠY WEBSITE
# ================================================================

# MongoDB Atlas, nhớ thêm tên database vào URI (ví dụ: /japan-learn)
MONGODB_URI=

# Hai chuỗi ngẫu nhiên khác nhau, mỗi chuỗi tối thiểu 32 ký tự
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudflare R2 dùng để lưu ảnh, audio và video
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain hoặc URL r2.dev, không có dấu / ở cuối
R2_PUBLIC_BASE_URL=

# ================================================================
# 2. TÙY CHỈNH R2 — CÓ THỂ GIỮ NGUYÊN
# ================================================================

R2_UPLOAD_PREFIX=web-learn-japan/uploads
R2_TEMP_PREFIX=web-learn-japan/temp
R2_TEMP_MAX_AGE_HOURS=24
R2_MAX_UPLOAD_BYTES=15728640
R2_MAX_AUDIO_UPLOAD_BYTES=52428800
R2_IMAGE_MAX_DIMENSION=1920
R2_IMAGE_WEBP_QUALITY=82

# Chỉ dùng khi chạy script kiểm kê/xóa media không còn được MongoDB sử dụng
R2_ORPHAN_GRACE_HOURS=168

# Để trống khi giao diện và API chạy cùng một domain
NEXT_PUBLIC_API_URL=
NODE_ENV=development
